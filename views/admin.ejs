<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin</title>
</head>
<body>
  <%- include('partials/navigation') %>

  <% if (contacts.length === 0) { %>
    <h1>There are no contacts yet.</h1>
  <% } %>

  <% contacts.forEach(contact => { %>
    <p>ID: <%= contact["id"] %></p>
    <p>First name: <%= contact["first_name"] %></p>
    <p>Last name: <%= contact["last_name"] %></p>
    <p>Job title: <%= contact["job_title"] %></p>
    <p>Company: <%= contact["company"] %></p>
    <p>LinkedIn: <%= contact["linkedin"] %></p>
    <p>Email: <%= contact["email"] %></p>
    <p>First contact method: <%= contact["first_contact_method"] %></p>
    <p>Other contact method: <%= contact["other_contact_method"] %></p>
    <p>Message: <%= contact["message"] %></p>
    <p>Mailing list: <%= contact["mailing_list"] %></p>
    <p>Email format: <%= contact["email_format"] %></p>
    <p>Date and time: <%= contact["timestamp"] %></p>
  <% }); %>

  <a href="/contact-form">Fill a new form</a>
</body>
</html>