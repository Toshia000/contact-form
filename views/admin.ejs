<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin</title>
</head>
<body>
  <%- include('partials/navigation') %>

  <% contacts.forEach(contact => { %>
    <p>First name: <%= contact["first-name"] %></p>
    <p>Last name: <%= contact["last-name"] %></p>
    <p>Job title: <%= contact["job-title"] %></p>
    <p>Company: <%= contact["company"] %></p>
    <p>LinkedIn: <%= contact["linkedin"] %></p>
    <p>Email: <%= contact["email"] %></p>
    <p>First contact method: <%= contact["first-contact-method"] %></p>
    <p>Other contact method: <%= contact["other-contact-method"] %></p>
    <p>Message: <%= contact["message"] %></p>
    <p>Mailing list: <%= contact["mailing-list"] %></p>
    <p>Email format: <%= contact["email-format"] %></p>
    <p>Date and time: <%= contact["timestamp"] %></p>
  <% }); %>

  <a href="/">Fill a new form</a>
</body>
</html>